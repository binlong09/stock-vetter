# Required
ANTHROPIC_API_KEY=

# Optional: User-Agent for SEC EDGAR (SEC requires identification on requests).
# Format: "Your Name your@email.com"
SEC_USER_AGENT=

# Required for the Signal Tracker (packages/signals): Financial Modeling Prep
# API key. Powers earnings-call transcripts, consensus estimates, and
# estimate-revision history. Get a key at
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Alpha Vantage API key — used by the EARNINGS_CALL_TRANSCRIPT adapter in
# packages/core (currently a viability/cost SPIKE, not a wired feed). Get a free
# key at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Turso (libSQL) database. Used by the read-only web viewer AND as the
# AUTHORITATIVE state store for the Signal Tracker (per-thesis cursors +
# tripwire status — see packages/signals). When set, `analyze-ticker` pushes
# decision cards and `track` persists/reads cursors here. When unset, the
# tracker falls back to the local .cache/signals/ cursor store (no status
# persistence) and the analyze CLI is fixtures-only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Signal Tracker scheduled cron (.github/workflows/signal-tracker.yml)
# ---------------------------------------------------------------------------
# The daily GitHub Actions run needs these as repository/organization SECRETS
# (Settings → Secrets and variables → Actions), NOT in this file:
#   ANTHROPIC_API_KEY    — LLM evaluation
#   FMP_API_KEY          — consensus estimates + ratings revisions
#   TURSO_DATABASE_URL   — authoritative cursor/status store
#   TURSO_AUTH_TOKEN
#   SEC_USER_AGENT       — "Your Name your@email.com"
# Steady-state runs are cents (cursor-gated). Only a cold start (new thesis or
# ticker) is expensive, and the cold-start guard in track.ts makes that an
# explicit opt-in (--allow-backlog) rather than an accident.
#
# Optional — email digest on tripwire flips (track.ts sends via Resend, reusing
# the web app's mail credentials). A digest is sent ONLY on a state transition
# (green→amber→red etc.), never per-event, and never twice for the same flip.
# If any of these are unset, no digest is sent and the run still works:
#   AUTH_RESEND_KEY          — Resend API key (same as the web auth uses)
#   EMAIL_FROM               — e.g. "Signal Tracker <onboarding@resend.dev>"
#   SIGNAL_DIGEST_TO         — recipient address (or pass --digest-to)
#   SIGNAL_TRACKER_BASE_URL  — deployed web origin, for detail-page links

# ---------------------------------------------------------------------------
# Short-Side Scanner (packages/local) — local GPU tier
# ---------------------------------------------------------------------------
# Requires Ollama running locally. Pull both models first:
#   ollama pull qwen3:32b
#   ollama pull nomic-embed-text
#
# None of these are required — every one has a working default. See SHORTSPEC.md.

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# Context window, pinned on every request. MUST exceed chunk size + output.
# Ollama does not error on an over-length prompt — it silently drops the front
# of it (the table header, the section heading) and answers anyway. Default
# 16384 comfortably holds an 8k chunk plus a 3k response.
OLLAMA_NUM_CTX=16384

# Concurrent requests to the local model. One GPU means one instance unless
# the server was started with OLLAMA_NUM_PARALLEL > 1.
OLLAMA_CONCURRENCY=1

# Embedding model for the lookback index. Changing this invalidates every
# stored vector — reindex after switching. bge-m3 scores better on financial
# retrieval if you have it.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local lookback index (raw filing text + vectors). Stays on the machine with
# the GPU: it is tens of GB, it is rebuildable from EDGAR, and the whole point
# is to avoid a network round-trip when verifying a number. Turso holds only
# the small finished artifacts.
LOOKBACK_DB_PATH=.cache/lookback.db

# Chunk-size token estimator coefficients. Defaults over-estimate on purpose —
# under-counting overflows the context window and truncates silently. Run
# `pnpm calibrate-tokens` to measure the real ratio for your model.
# LOCAL_CHARS_PER_TOKEN_TEXT=3.6
# LOCAL_CHARS_PER_TOKEN_DIGIT=2.0

# EDGAR request pacing, ms between requests. SEC's fair-access limit is 10/s;
# exceeding it earns a ten-minute IP block that is invisible in the response.
# SEC_MIN_INTERVAL_MS=125
